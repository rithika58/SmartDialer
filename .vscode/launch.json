{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sim: full matrix (A-D, both modes, both providers)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_sim.py",
      "args": ["--agents", "100", "--duration", "1800"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Sim: hostile provider only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_sim.py",
      "args": ["--provider", "B", "--agents", "50", "--duration", "900"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Failure demo (5 cases)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo_failures.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Load test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_test.py",
      "args": ["--agents", "2000", "--workers", "16", "--seconds", "5"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Generate dashboard",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/gen_dashboard.py",
      "args": ["--agents", "60", "--minutes", "30"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Useful when they ask you to "walk me through the two-workers race".
      // Put a breakpoint inside SQLiteStore.claim_agent and run this.
      "name": "Debug: the two-workers-one-agent race",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_concurrency.py::test_no_agent_is_ever_allocated_twice",
        "-s"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
