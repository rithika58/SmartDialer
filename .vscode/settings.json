{
  // ---------------------------------------------------------------------
  // SmartDialer workspace settings.
  //
  // The scripts add `src` to sys.path themselves, so nothing here is strictly
  // required to run them. These settings exist so that IntelliSense, Pylance
  // and the test explorer resolve `import smartdialer` correctly.
  // ---------------------------------------------------------------------

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.autoTestDiscoverOnSaveEnabled": false,

  // Lets Pylance/goto-definition find the package without installing it.
  "python.analysis.extraPaths": ["src"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoSearchPaths": true,
  "python.analysis.useLibraryCodeForTypes": true,

  // Pick the interpreter you created with `python3 -m venv .venv`.
  // If you would rather not create a venv, delete this line and VS Code will
  // use the system python3, which works fine here (stdlib only).
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  "editor.formatOnSave": true,
  "editor.rulers": [88],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // Keep generated noise out of the explorer.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".pytest_cache": true,
    "**/.mypy_cache": true
  },

  // The dashboard is a static file -- open it in a browser tab, not an editor.
  "workbench.editorAssociations": {
    "*.html": "vscode.livepreview"
  }
}
